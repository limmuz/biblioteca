# Exemplo de configuração - NÃO COLOQUE SENHAS REAIS AQUI
spring.data.mongodb.uri=mongodb+srv://<usuario>:<senha>@cluster.mongodb.net/db
jwt.secret=<chave-de-pelo-menos-32-caracteres>
app.seed.enabled=false
cloudinary.cloud-name=seu_cloud_name
cloudinary.api-key=sua_api_key
cloudinary.api-secret=seu_api_secret