# MongoDB Atlas
spring.data.mongodb.uri=mongodb+srv://<usuario>:<senha>@<cluster>.mongodb.net/<banco>?retryWrites=true&w=majority

# JWT
jwt.secret=<chave-secreta-minimo-32-caracteres>
jwt.expiration-ms=86400000

# ViaCEP (opcional, usa padrão se não configurado)
# viacep.base-url=https://viacep.com.br/ws
